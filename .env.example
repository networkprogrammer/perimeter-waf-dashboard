# Copy to .env and edit. Every value is optional except the Athena results location (unless your
# workgroup already enforces one) and, if different from the default, the regions.

# --- Where the Security Lake WAF tables live --------------------------------------------------
# Comma separated regions that have a Security Lake WAF source. One poller pair runs per region.
WAF_REGIONS=us-east-1

# Athena workgroup used for every query, and where it writes results. {region} is substituted.
# The role you run with needs write access to this bucket.
WAF_ATHENA_WORKGROUP=primary
WAF_ATHENA_OUTPUT=s3://<ATHENA_RESULTS_BUCKET>/waf-dashboard/

# Only needed if your Security Lake database or table names differ from the defaults.
# WAF_SL_DB_TEMPLATE=amazon_security_lake_glue_db_{region_u}
# WAF_SL_TABLE_TEMPLATE=amazon_security_lake_table_{region_u}_waf_2_0

# --- Credentials ------------------------------------------------------------------------------
# By default the standard AWS credential chain is used (EC2 instance profile, ECS/EKS role,
# AWS_* environment variables, mounted ~/.aws, ...). Nothing else to set in that case.
# WAF_AWS_PROFILE=<PROFILE_NAME>
# Compose forwards AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_SESSION_TOKEN from your shell.
# Prefer short-lived credentials or instance/task roles. Never commit keys or tokens.
# Shared profiles also require volume mounts and AWS file paths; see docs/iam.md.
# Optional extra hop, for example a role in the account that owns the Security Lake tables:
# WAF_ASSUME_ROLE_ARN=arn:aws:iam::<SECURITY_LAKE_ACCOUNT_ID>:role/<READER_ROLE_NAME>
# WAF_ASSUME_ROLE_EXTERNAL_ID=<EXTERNAL_ID>

# --- Polling and retention --------------------------------------------------------------------
# WAF_POLL_SECONDS=30
# WAF_AGG_SECONDS=60
# WAF_ATHENA_CONCURRENCY=3
# WAF_BACKFILL_HOURS=24
# WAF_RETENTION_HOURS=72

# --- Display ----------------------------------------------------------------------------------
# JSON object of account id -> friendly name, mounted into the container (see docker-compose.yml)
# WAF_ACCOUNTS_FILE=/config/accounts.json
# Prefixes to hide from rule names in the UI, comma separated
# WAF_RULE_STRIP_PREFIXES=example-custom-,example-global-
# public = look up source IP owners with Team Cymru / RDAP / RADb, off = disable
# WAF_WHOIS=public

# --- Network exposure and access control ------------------------------------------------------
# WAF_BIND=127.0.0.1
# WAF_PORT=8080
# Host names/addresses users type in the browser. Requests with any other Host header are rejected
# (protects against DNS rebinding). Required when exposing beyond loopback, e.g.:
# WAF_ALLOWED_HOSTS=waf.example.com,10.0.0.15
# Optional built-in gate, "user:password" (password at least 12 characters, otherwise the app refuses
# to start). Only use over HTTPS (reverse proxy).
# WAF_BASIC_AUTH=
# Behind a reverse proxy: the proxy's address, so per-client limits see real client IPs.
# FORWARDED_ALLOW_IPS=127.0.0.1
# WAF_MAX_STREAMS=50
# WAF_API_QUERY_TIMEOUT=15

# --- Offline demo -----------------------------------------------------------------------------
# Synthetic data only, no AWS calls. Use a separate volume from a real deployment.
# WAF_DEV_FAKE=1

# --- Deep Search cost controls ----------------------------------------------------------------
# WAF_SEARCH_PER_CLIENT_HOUR=30
# WAF_SEARCH_GLOBAL_HOUR=120
# Stop accepting searches after this many GB scanned per UTC day (0 = no budget)
# WAF_SEARCH_DAILY_SCAN_GB=0
